				Vseq.write("\n".join(['\t'.join(map(str, (item[i] for i in indxs))) for item in information])+"\n")
			Vseq.close()
			
			if len(trip) != 0:
				indxs = [0,21,22,24,14,16,17,18,19,15]
				if reportReadNames == "yes": indxs.append(23)
				SUMM.write("\n".join([GENE+"\t"+trip[item][20]+"\t"+'\t'.join(map(str, map(trip[item].__getitem__, indxs))) for item in trip])+"\n")
			else:
				SUMM.write(GENE+"\tNo rearrangement found"+"\tNA"*(10 if reportReadNames == "no" else 11)+"\n")
		
