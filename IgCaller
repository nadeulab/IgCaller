			Vseq.write("Genes\tMechanism\tScore\tMQ\tNum_reads\tAdjusted_mean_pre_break\tAdjusted_mean_post_break\tP_value\tPct_reduction_adjusted_means"+("" if reportReadNames == "no" else "\tRead_names")+"\n")
			if len(class_switch) > 0:
				indxs = [0,1,2,3,4,5,6,7,8]
				if reportReadNames == "yes": indxs.append(9)
				Vseq.write("\n".join(['\t'.join(map(str, (item[i] for i in indxs))) for item in class_switch])+"\n")
			Vseq.close()
			
			if len(class_switch_filt) == 0:
				SUMM.write("CSR\tIGHM\tNo CSR found"+"\tNA"*(9 if reportReadNames == "no" else 10)+"\n")
			else:
				class_switch_filt = class_switch_filt[reductionMeans.index(max(reductionMeans))] # keep only the one with highest reduction/score
				SUMM.write("\t".join(["CSR", class_switch_filt[0], class_switch_filt[1], str(class_switch_filt[2]), class_switch_filt[3], str(class_switch_filt[4])]+["NA"]*6)+("" if reportReadNames == "no" else "\t"+class_switch_filt[9])+"\n")
		
