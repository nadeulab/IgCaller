		subprocess.call(comms, shell=True)
		
		miniSamT = wkDir+"/tmp/"+bamT.split("/")[-1].replace(".bam", "_miniSam.sam")
		comms = pathToSamtools+"samtools view -@ "+threadsForSamtools+" -q "+mapq+" "+bamT+" "+coordsToSubsetLocus+" > "+miniSamT
		subprocess.call(comms, shell=True)
		
