if runOnlyOncogenicRearrangements == "no":	
	
	for GENE in listGenes:
		
		print(str(datetime.datetime.now().strftime("%Y-%m-%d %H:%M:%S"))+" - IgCaller: analyzing %s..." %GENE)
		
		# 1) Get general information:
		chromGene, coordsToSubsetLocus, bedFile, Dseqs, germline_db_J, germline_db_D, germline_db_V, snps_file = getGeneralInfo(GENE, chrom, genomeVersion, inputsFolder, chrAnnot, annotateSeqDB)

		# 2) Create mini IG-locus-specific-BAM:
		miniBamT = wkDir+"/tmp/"+bamT.split("/")[-1].replace(".bam", "_miniBam.bam")
