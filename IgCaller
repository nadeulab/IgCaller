#!/usr/bin/env python3

# Modules
import argparse
import subprocess
import sys
import os
import datetime

# Function to check inputs
def check_empty_or_integer(value):
	if value == "":
		return(value)
	else:
		if value.isdigit():
			return(value)
		else:
			sys.exit(str(datetime.datetime.now().strftime("%Y-%m-%d %H:%M:%S"))+" - IgCaller: error message... '"+value+"' should be an integer.")

# Manage inputs
parser  = argparse.ArgumentParser(prog='IgCaller', description='''IgCaller v2.0 (https://github.com/ferrannadeu/IgCaller)''')

parser.add_argument('-v', '--version', action='version', version="%(prog)s v2.0")

# Mandatory:
parser.add_argument('-I', '--inputsFolder',
					dest = "inputsFolder",
					action = "store",
					required = True,
					help = "Path to folder containing IgCaller reference files.") 

parser.add_argument('-V', '--genomeVersion',
					dest = "genomeVersion",
					action = "store",
					choices = ['hg19', 'hg38'],
					required = True,
					help = "Reference genome version [hg19, hg38].") 

parser.add_argument('-C', '--chromosomeAnnotation',
					dest = "chrAnnot",
					action = "store",
					choices = ['ensembl', 'ucsc'],
					required = True,
					help = "Chromosome annotation [ensembl = without 'chr' (i.e. 1); ucsc = with 'chr' (i.e. chr1)].") 

parser.add_argument('-T', '--bamT',
					dest = "bamT",
					action = "store",
					required = True,
					help = "Path to tumor BAM file.") 

parser.add_argument('-seq', '--sequencing', 
					dest = "seq",
					action = "store",
					required = True,
					choices = ['wgs', 'wes', 'capture', 'amplicon'],
					help = "Sequencing technique [whole-genome sequencing (wgs), whole-exome sequencing (wes), high-coverage capture NGS (capture), or amplicon-based NGS (amplicon)].")

parser.add_argument('-seqDepth', '--sequencingDepth', 
					dest = "seqDepth",
					action = "store",
					required = True,
					choices = ['low', 'int', 'high'],
					help = "Sequencing depth [low (~30x), int (50-200x), high (>250x)].")

parser.add_argument('-N', '--bamN',
					dest = "bamN",
					action = "store",
					default = None,
					help = "Path to normal BAM file, if available.") 

parser.add_argument('-pm', '--pairedMode',
					dest = "pairedMode",
					action = "store",
					default = None,
					choices = ['paired', 'unpaired'],
					help = "Tumor and normal paired status [paired/unpaired, default=None]. Need to be specified when bamN is specified. Paired = Normal BAM used for all analyses. Unpaired = Normal BAM only used during the estimation of tumor purity based on coverage.") 

parser.add_argument('-R', '--refGenome',
					dest = "refGenome",
					action = "store",
					default = None,
					help = "Path to reference genome FASTA file. Not mandatory, but recommended, when specifying a normal BAM file using the argument 'bamN'. Mandatory when '-bamN' is not specified and when '-seq' is set to 'amplicon'.") 

# Gene/receptor to be analyzed:
parser.add_argument('-g', '--geneToAnalyze',
					dest = "geneToAnalyze",
					action = "store",
					choices = ['ig', 'tcr', 'both'],
					default = "ig",
					help = "Gene/receptor to be analyzed [ig/tcr/both, default=ig].") 

# Amplicon-based sequencing:
parser.add_argument('-pr', '--primer',
					dest = "primer",
					action = "store",
					default = None,
					choices = ['leader', 'fr1', 'cdr1', 'fr2', 'cdr2', 'fr3', 'Vseq'],
					help = "Location of the primer in the V gene for amplicon-based data [leader/fr1/cdr1/fr2/cdr2/fr3/Vseq, default=None]. It is used to cut the sequence after the primer location (if leader, fr1, cdr1, fr2, cdr2, fr3) or sequence (if Vseq) prior annotation and identity calculation. Only applicable when IgBLAST is used for the annotation using the '-a' argument. Required if '-seq amplicon'. See parameter '--primerStringency' and 'primerFasta' for further tunning.")

parser.add_argument('-prf', '--primerFasta',
					dest = "primerFasta",
					action = "store",
					default = "",
					help = "Fasta file with primer sequences annealing to V genes that need to be removed from the sequence. Mandatory when '-pr/--primer' is 'Vseq'. Sequence name (or header line) in fasta file must start with '>locus', where locus is IGH, IGK, IGL, TRA, TRAB, TRAG, or TRAD to allow locus-specific mapping and elimination of primers. Only applicable when IgBLAST is used for the annotation using the '-a' argument (recommended).")

parser.add_argument('-prs', '--primerStringency',
					dest = "primerStringency",
					action = "store",
					default = "strict",
					choices = ['strict', 'permissive'],
					help = "Primer stringency [strict/permissive, default=strict]. Mandatory when '-pr/--primer' is 'leader', 'fr1', 'cdr1', 'fr2', 'cdr2', or 'fr3'. 'strict' = only annotate sequences with nucleotides found after the expected location of the primer. 'permissive' = annotate sequences even if they start later than the expected location of the primer. Only applicable when IgBLAST is used for the annotation using the '-a' argument (recommended).")

# Purity of the tumor sample:
parser.add_argument('-p', '--tumorPurity', 
					dest = "tumorPurity",
					action = "store",
					default = "1",
					type = float,
					help = "Purity (or tumor cell contect) of the tumor sample, if known [0-1, default=1]. It is used to adjust the scores and some internal cutoffs during the analysis. If unknown, use 1.") 

# Output path and options:
parser.add_argument('-o', '--outputPath',
					dest = "outputPath",
					action = "store",
					default = None,
					help = "A folder inside this directory will be created with the output [default = current directory].") 

parser.add_argument('-kmb', '--keepMiniIgBams',
					dest = "keepMiniIgBams",
					action = "store",
					default = "no",
					help = "Should IgCaller keep (ie no remove) mini IG BAM files used in the analysis? [no/yes, default=no].")

parser.add_argument('-rrn', '--reportReadNames', 
					dest = "reportReadNames",
					action = "store",
					default = "no",
					choices = ['no', 'yes'],
					help = "Report read names associated with each rearrangement found [no/yes, default=no].")

# Annotation tool and database:
parser.add_argument('-a', '--annotateSeq',
					dest = "annotateSeq",
					action = "store",
					default = "igblast",
					choices = ['builtin', 'igblast'],
					help = "Annotate sequence using IgCaller built-in annotation workflow or using IgBLAST [builtin/igblast, default=igblast].") 

parser.add_argument('-aa', '--annotateSeqDB',
					dest = "annotateSeqDB",
					action = "store",
					default = "imgt",
					choices = ['imgt', 'ogrdb'],
					help = "Database of sequences to be used by IgBLAST [imgt/ogrdb, default=imgt]. IMGT = release 202430-2 (23 July 2024); OGRDB = release 2024-10-12.") 

# CLL-specific annotations:
parser.add_argument('-subsets', '--subsetsAnnotation', 
					dest = "subsetsAnnotation",
					action = "store",
					default = "no",
					choices = ['no', 'imgt', 'major'],
					help = "Should CLL stereotype subsets be annotated? Only applicable to productive IGH gene rearrangements. 'imgt' to annotate #2 and #8 using IMGT criteria; 'major' to annotate all major subsets based on the definitions reported in Agathangelidis et al Blood 2021 [no/imgt/major, default = no].")

parser.add_argument('-R110', '--R110annotation', 
					dest = "R110annotation",
					action = "store",
					default = "no",
					choices = ['no', 'yes'],
					help = "Should the R110 mutation in IGLV3-21 be annotated? Annotation based on the definitions reported in Nadeu et al Blood 2021 [no/yes, default = no].")

# Acquired N-glycosylation sites (AGS) annotation:
parser.add_argument('-ags', '--agsAnnotation',
					dest = "agsAnnotation",
					action = "store",
					default = "no",
					choices = ['no', 'yes'],
					help = "Should acquired N-glycosylation sites (AGS) be annotated? Only applicable to productive IGH gene rearrangements and requires '-a igblast'. AGS annotation based on the definitions reported in Tatterton et al Blood 2025 [no/yes, default = no].")

# IG/TCR reconstruction:
parser.add_argument('-hs', '--highSensitivity', 
					dest = "highSensitivity",
					action = "store",
					default = "yes",
					choices = ['no', 'yes'],
					help = "highSensitivity = no: runs faster by skipping low-confidence rearrangements. highSensitivity = yes: may run significantly slower in some samples since it tries to recover low-confidence rearrangements [no/yes, default = yes].")

parser.add_argument('-mnns', '--minimumNumberOfNucleotidesSoft',
					dest = "minimumNumberOfNucleotidesSoft",
					action = "store",
					default = "5",
					type = int,
					help = "Minimum number of soft-clipped nucleotides to consider a read as split-read and number of nucleotides to be aligned on a J-V, J-D or D-V break in order to recover the read as a split-read covering the rearrangement [integer number higher than 0, default = 5].")

parser.add_argument('-prbm', '--phaseReadsBasedOnMutations', 
					dest = "phaseReadsBasedOnMutations",
					action = "store",
					default = "yes",
					choices = ['no', 'yes'],
					help = "Phase reads based on mutations identified in the V gene. They will be used to reconstruct the sequence on the V gene but not considered to calculate the score and mapping quality [no/yes, default = yes].")

parser.add_argument('-kisor', '--keepInsertSizeOnlyRearrangements', 
					dest = "keepInsertSizeOnlyRearrangements",
					action = "store",
					default = "no",
					choices = ['no', 'yes'],
					help = "Specify if IG/TCR rearrangements supported only by insert-size reads (i.e., no split-reads) should be kept [no/yes, default = no]. If kept, they are labeled with the tag 'Rearrangement without junction coverage' and the nucleotide sequences, functionality, identity to germline, and other features are not computed. If specified, these rearrangements are reported in the filtered output independently of the value specified in the '-rop' argument.")

parser.add_argument('-cs', '--collapseSequences', 
					dest = "collapseSequences",
					action = "store",
					default = "yes",
					choices = ['no', 'yes'],
					help = "Collapse IG/TCR sequences if they are similar at nucleotide level. If so, the sequence of the rearrangement supported with the highest score is kept, but number of reads and read names are merged in the output [no/yes, default = yes].")

parser.add_argument('-css', '--collapseSequencesSimilarity', 
					dest = "collapseSequencesSimilarity",
					action = "store",
					default = "0.98",
					type = float,
					help = "Cutoff of similarity between two IG/TCR sequences in order to be collapsed [0-1, default=0.98].")

parser.add_argument('-shortV', '--shortReportedVseq',
					dest = "shortV",
					action = "store",
					default = "yes",
					choices = ['no', 'yes'],
					help = "Make V sequence start at (approx) FR1 [yes/no, default=yes].")

parser.add_argument('-mq', '--mappingQuality',
					dest = "mapq",
					action = "store",
					default = "0",
					type = int,
					help = "Mapping quality cut off to filter out reads for IG/TCR V(D)J reconstruction [default=0].") 

parser.add_argument('-bq', '--baseQuality',
					dest = "baseq",
					action = "store",
					default = "13",
					type = int,
					help = "Base quality cut off for samtools mpileup for mutation analysis [default=13].") 

parser.add_argument('-d', '--minDepth',
					dest = "depth",
					action = "store",
					default = "1",
					type = int,
					help = "Depth cut off to consider a position [0-inf, default=1].")
					
parser.add_argument('-ad', '--minAltDepth',
					dest = "altDepth",
					action = "store",
					default = "1",
					type = int,
					help = "Alt depth cut off to consider a nucleotide [0-inf, default=1].")
					
parser.add_argument('-vaf', '--vafCutoff',
					dest = "vafCutoff",
					action = "store",
					default = "0.5,0.1",
					help = "VAF cut off to consider a mutation when working with phased reads and without phased reads, respectively [two numbers between 0-1 separated by comma, default=0.5,0.1].")	

parser.add_argument('-vafN', '--vafCutoffNormal',
					dest = "vafCutoffNormal",
					action = "store",
					default = "0.20",
					type = float,
					help = "VAF cut off to consider a variant in the normal sample [0-1, default=0.20].")

parser.add_argument('-s', '--scoreCutoff',
					dest = "scoreCutoff",
					action = "store",
					default = "",
					type = check_empty_or_integer,
					help = "Minimum score supporting a gene rearrangement in order to be considered as high confidence [default='empty'; will consider 5 for seqDepth = low, 10 for int, and 15 for high].")

parser.add_argument('-sf', '--scoreCutoffFilter',
					dest = "scoreCutoffFilter",
					action = "store",
					default = "",
					type = check_empty_or_integer,
					help = "Minimum score supporting a gene rearrangement in order to be kept during the analysis (intermediate filtering step to speed up the analysis) [default='empty'; will consider 2 for seqDepth = low, 5 for int, and 10 for high].")

parser.add_argument('-scsr', '--scoreCutoffCSR',
					dest = "scoreCutoffCSR",
					action = "store",
					default = "",
					type = check_empty_or_integer,
					help = "Minimum score supporting a CSR rearrangement in order to be considered as high confidence [default='empty'; will consider 5 for seqDepth = low, 10 for int, and 15 for high].")

parser.add_argument('-rop', '--reportOnlyProductive',
					dest = "reportOnlyProductive",
					action = "store",
					default = "no",
					choices = ['no', 'oof', 'yes'],
					help = "Report only productive rearrangements in the 'output_filtered' file [no/oof/yes, defaul=no]. 'no' = report all rearrangements identified. 'oof' means out-of-frame and is used to filter out as unproductive only those rearrangements with an out-of-frame junction or, in other words, to report both productive rearrangements and in-frame rearrangements that are unproductive due to stop codons. 'yes' = report only productive rearrangements.")

# Oncogenic rearrangements (i.e., translocations, etc.):
parser.add_argument('-ror', '--runOncogenicRearrangements',
					dest = "runOncogenicRearrangements",
					action = "store",
					default = "yes",
					choices = ['no', 'yes'],
					help = "Run the analysis of oncogenic IG/TCR rearrangements [yes/no, default=yes].") 

parser.add_argument('-roor', '--runOnlyOncogenicRearrangements',
					dest = "runOnlyOncogenicRearrangements",
					action = "store",
					default = "no",
					choices = ['no', 'yes'],
					help = "Run only the analysis of oncogenic IG/TCR rearrangements [yes/no, default=no].") 

parser.add_argument('-mqOnco', '--mappingQualityOncoIg',
					dest = "mapqOnco",
					action = "store",
					default = "0",
					type = int,
					help = "Mapping quality cut off to filter out reads when analyzing oncogenic IG/TCR rearrangements [default=0].") 

parser.add_argument('-mntonco', '--minNumberReadsTumorOncoIg', 
					dest = "mntonco",
					action = "store",
					default = "5",
					type = int,
					help = "Minimum score supporting an oncogenic IG/TCR rearrangement in order to be annotated [default=5].")

parser.add_argument('-mntoncoPass', '--minNumberReadsTumorOncoIgPass', 
					dest = "mntoncoPass",
					action = "store",
					default = "",
					type = check_empty_or_integer,
					help = "Minimum score supporting an oncogenic IG/TCR rearrangement in order to be considered as high confidence [default='empty'; will consider 6 for seqDepth = low, 10 for int, and 15 for high].")

parser.add_argument('-vafOnco', '--vafOncoIgPass', 
					dest = "vafOnco",
					action = "store",
					default = "0.05",
					type = float,
					help = "Minimum VAF of an oncogenic IG/TCR rearrangement in order to be considered as high confidence [range: 0-1; default=0.05].")

parser.add_argument('-mnnonco', '--maxNumberReadsNormalOncoIg', 
					dest = "mnnonco",
					action = "store",
					default = "2",
					type = int,
					help = "Maximum number of reads supporting an oncogenic IG/TCR rearrangement in the normal sample in order to be considered as high confidence [default=2].")

parser.add_argument('-mncPoN', '--maxNumberCountInPoN', 
					dest = "mncPoN",
					action = "store",
					default = "2",
					type = int,
					help = "Maximum number of count in panel of normals (PoN) in order to be considered as high confidence [default=2].")

parser.add_argument('-gOnco', '--genesOncoIg', 
					dest = "genesOncoIg",
					action = "store",
					default = "protein_coding_canonical",
					choices = ['all', 'protein_coding', 'protein_coding_canonical'],
					help = "Genes to be annotated based on proximity to the oncogenic IG/TCR rearrangement breakpoints. All genes, only protein coding genes, or only canonical portein coding transcripts. For hg19 reference, protein_coding_canonical is not supported and it is treated as protein_coding. [all/protein_coding/protein_coding_canonical, default=protein_coding_canonical].")

parser.add_argument('-cgOnco', '--customGenesOncoIg', 
					dest = "customGenesOncoIg",
					action = "store",
					default = "",
					help = "Comma-separated list of genes to be annotated with higher priority on the non-IG/TCR breakpoint if they are found within '-gOncoDist' of the breakpoint [default=''].")

parser.add_argument('-gOncoDist', '--genesOncoIgDistance',
					dest = "genesOncoIgDistance",
					action = "store",
					default = "250000",
					type = int,
					help = "Maximum distance in base pairs from the non-IG/TCR breakpoint to the closest gene to annotate it [default=250000].")

parser.add_argument('-cgOncoDist', '--customGenesOncoIgDistance',
					dest = "customGenesOncoIgDistance",
					action = "store",
					default = "500000",
					type = int,
					help = "For genes provided in -cgOnco, maximum distance in base pairs from the non-IG/TCR breakpoint to the closest gene to annotate it [default=500000].")

# Purity calculation:
parser.add_argument('-ep', '--estimatePurity', 
					dest = "estimatePurity",
					action = "store",
					default = "yes",
					choices = ['no', 'yes'],
					help = "Estimate purity [no/yes, default=yes]. If specified, the purity is estimated based on the IG/TCR rearrangements and reported in the output. It does not effect the scores and internal cutoffs.") 

parser.add_argument('-epc', '--estimatePurityCoverage', 
					dest = "estimatePurityCoverage",
					action = "store",
					default = "no",
					choices = ['no', 'yes', 'igh'],
					help = "Count gene rearrangements when estimating purity based on drop of coverage even if IgCaller has not called the rearrangement [no/yes/igh, default=no]. 'igh' means only applied to IGH locus.") 

parser.add_argument('-scp', '--scoreCutoffPurity',
					dest = "scoreCutoffPurity",
					action = "store",
					default = "",
					type = check_empty_or_integer,
					help = "Minimum score supporting a rearrangement in order to be considered during purity calculation [default='empty'; same as 'scoreCutoff'].")

parser.add_argument('-ppc', '--plotPurityCoverage',
					dest = "plotPurityCoverage",
					action = "store",
					default = "yes",
					choices = ['no', 'yes'],
					help = "Plot coverage along J genes to visually evaluate coverage estimations [no/yes, default='yes'].")

# Samtools-related arguments:
parser.add_argument('-ptsam', '--pathToSamtools',
					dest = "pathToSamtools",
					action = "store",
					default = "",
					help = "Path to the directory where samtools is installed. No need to specify it if samtools is found in 'PATH' [default = 'empty', assuming it is in 'PATH'].") 

parser.add_argument('-@', '--threadsForSamtools', 
					dest = "threadsForSamtools",
					action = "store",
					default = "1",
					type = int,
					help = "Maximum number of threads used for samtools [default=1].")

options = parser.parse_args()

# Starting:
startTime = datetime.datetime.now()
print(str(datetime.datetime.now().strftime("%Y-%m-%d %H:%M:%S"))+" - IgCaller v2.0")
print(str(datetime.datetime.now().strftime("%Y-%m-%d %H:%M:%S"))+" - IgCaller: starting run...")

# Prepare some variables and files:
print(str(datetime.datetime.now().strftime("%Y-%m-%d %H:%M:%S"))+" - IgCaller: checking inputs...")

inputsFolder = options.inputsFolder
genomeVersion = options.genomeVersion
chrAnnot = options.chrAnnot
originalBamT = options.bamT
seq = options.seq
seqDepth = options.seqDepth
originalBamN = options.bamN
pairedMode = options.pairedMode
refGenome = options.refGenome
geneToAnalyze = options.geneToAnalyze
primer = options.primer
primerFasta = options.primerFasta
primerStringency = options.primerStringency
tumorPurity = options.tumorPurity
outputPath = options.outputPath
keepMiniIgBams = options.keepMiniIgBams
reportReadNames = options.reportReadNames
annotateSeq = options.annotateSeq
annotateSeqDB = options.annotateSeqDB
subsetsAnnotation = options.subsetsAnnotation
R110annotation = options.R110annotation
agsAnnotation = options.agsAnnotation
highSensitivity = options.highSensitivity
minimumNumberOfNucleotidesSoft = options.minimumNumberOfNucleotidesSoft
phaseReadsBasedOnMutations = options.phaseReadsBasedOnMutations
keepInsertSizeOnlyRearrangements = options.keepInsertSizeOnlyRearrangements
collapseSequences = options.collapseSequences
collapseSequencesSimilarity = float(options.collapseSequencesSimilarity)
shortV = options.shortV
mapq = str(options.mapq)
baseq = str(options.baseq)
depth = options.depth
altDepth = options.altDepth
vafCutoff = options.vafCutoff.rstrip(",").split(",")
vafCutoffNormal = options.vafCutoffNormal
scoreCutoff = int(options.scoreCutoff) if options.scoreCutoff != "" else 15 if seqDepth == "high" else 10 if seqDepth == "int" else 5
scoreCutoffFilter = int(options.scoreCutoffFilter) if options.scoreCutoffFilter != "" else 10 if seqDepth == "high" else 5 if seqDepth == "int" else 2
if scoreCutoffFilter > scoreCutoff: scoreCutoffFilter = scoreCutoff
scoreCutoffPurity = int(options.scoreCutoffPurity) if options.scoreCutoffPurity != "" else scoreCutoff
scoreCutoffCSR = int(options.scoreCutoffCSR) if options.scoreCutoffCSR != "" else 15 if seqDepth == "high" else 10 if seqDepth == "int" else 5
reportOnlyProductive = options.reportOnlyProductive
runOncogenicRearrangements = options.runOncogenicRearrangements
runOnlyOncogenicRearrangements = options.runOnlyOncogenicRearrangements
mapqOnco = str(options.mapqOnco)
mntonco = int(options.mntonco)
mntoncoPass = int(options.mntoncoPass) if options.mntoncoPass != "" else 15 if seqDepth == "high" else 10 if seqDepth == "int" else 6
vafOnco = options.vafOnco
mnnonco = options.mnnonco
mncPoN = options.mncPoN
genesOncoIg = options.genesOncoIg
customGenesOncoIg = options.customGenesOncoIg.split(",")
genesOncoIgDistance = options.genesOncoIgDistance
customGenesOncoIgDistance = options.customGenesOncoIgDistance
estimatePurity = options.estimatePurity
estimatePurityCoverage = options.estimatePurityCoverage
plotPurityCoverage = options.plotPurityCoverage
pathToSamtools = options.pathToSamtools if options.pathToSamtools == "" else options.pathToSamtools+"/"
threadsForSamtools = str(options.threadsForSamtools)

## Import IgCaller defined dictionaries and functions from IgCaller_reference_files:
sys.path.insert(0, inputsFolder)
from IgCaller_functions import *

## Check normal BAM or reference is available:
if originalBamN is None and refGenome is None:
	sys.exit(str(datetime.datetime.now().strftime("%Y-%m-%d %H:%M:%S"))+" - IgCaller: error message... normal BAM file and/or reference genome must be supplied using -N and -R, resepctively.")

## Check normal BAM and pairedMode specifications:
if originalBamN is not None and pairedMode is None:
	sys.exit(str(datetime.datetime.now().strftime("%Y-%m-%d %H:%M:%S"))+" - IgCaller: error message... pairedMode (-pm) must be specified when a normal BAM file is supplied.")

## Check pairedMode should be set to paired if reference is not available
if pairedMode == "unpaired" and refGenome is None:
	sys.exit(str(datetime.datetime.now().strftime("%Y-%m-%d %H:%M:%S"))+" - IgCaller: error message... a paired normal BAM file or the reference genome must be supplied.")

## Check refGenome should be set if seq is amplicon and annotateSeq is igblast
if seq == "amplicon" and refGenome is None and annotateSeq == "igblast":
	sys.exit(str(datetime.datetime.now().strftime("%Y-%m-%d %H:%M:%S"))+" - IgCaller: error message... reference genome must be supplied using -R when analyzing amplicon-based data (i.e., -seq amplicon) coupled with IgBLAST annotation (i.e., -a igblast).")

## Check IgBLAST database for TCR/all:
if annotateSeq == "igblast" and annotateSeqDB == "ogrdb" and geneToAnalyze in ["tcr", "both"]:
	sys.exit(str(datetime.datetime.now().strftime("%Y-%m-%d %H:%M:%S"))+" - IgCaller: error message... the 'ogrdb' can only be used to annotate IG genes. Please, use 'imgt' database to analyze TCR or IG+TCR. You can also analyze IG and TCR in independent runs, using 'ogrdb' for IG analyses.")

## Check collapse sequences:
if collapseSequencesSimilarity < 0 or collapseSequencesSimilarity > 1: 
