			subprocess.call(comms, shell=True)
			comms = pathToSamtools+"samtools index -@ "+threadsForSamtools+" "+miniBamN 
			subprocess.call(comms, shell=True)

		# 3) Convert SAM file to annotated table and write to disc:
		## Take samfile, get columns of interest and anotate reads with large insert size (as insertSize) and split/soft clipped (as split) 
		annot_table = miniSamT.replace(".sam", "_splitinsert.tsv")
		store = convertSamToAnnotatedTable(miniSamT, chromGene, GENE, minimumNumberOfNucleotidesSoft)
		ANNOT_TABLE = open(annot_table, "w")
		for read, data in store.items(): ANNOT_TABLE.write("%s\n" %"\t".join([str(x) for x in data]))
		ANNOT_TABLE.close()
		
		# 4) Find the J and V genes corresponding to each split/insert size position:
		JV_list = findJandVgenes(annot_table, bedFile, GENE, genomeVersion)
		annot_table_JV = miniSamT.replace(".sam", "_splitinsert_VJ.tsv")
		ANNOT_TABLE_JV = open(annot_table_JV, "w")
		for i in JV_list: ANNOT_TABLE_JV.write(i)
		ANNOT_TABLE_JV.close()
		
		# 5) Find combinations of J-V:
		l = findCombinationsJandV(annot_table_JV, GENE)

		# 6) Assign positions/breaks to each J and V pairs:
		VJ_positions, data, pos = assignPositionsToJandV(l, annot_table_JV, seq, GENE)

		if GENE != "CSR":
			# 7) Append to list V,J positions and number of occurrences:
			information = addPositionsAndOccurrences(GENE, pos, bedFile, shortV, data)
			
			# 8) Clean positions and occurrences:
			information = cleanPositionsAndOccurrences(GENE, bedFile, information, highSensitivity, seq)

			# 9) Add readnames:
			information = addReadNames(GENE, information, annot_table_JV)

			# 10) Get J and V sequences:
			information = getJandVsequences("first", seq, phaseReadsBasedOnMutations, information, annot_table_JV, GENE, refGenome, snps_file, baseq, chromGene, bamN, pairedMode, miniBamT, miniBamN, depth, altDepth, tumorPurity, vafCutoff, vafCutoffNormal, pathToSamtools, threadsForSamtools, errLogMpileup)

			# 11) Get D sequences (IGH/TRB/TRD = N-D-N, IGK/IGL/TRA/TRG = N):
			information = getDsequence(information, annot_table_JV, GENE, Dseqs, minimumNumberOfNucleotidesSoft, seq, bedFile, refGenome, miniBamT, pathToSamtools, errLogMpileup)

			# 12) Remove low support rearrangements and adjust insertSize only rearrangements:
			information = removeLowSupportRearrangements(information, tumorPurity, scoreCutoffFilter, keepInsertSizeOnlyRearrangements, annot_table_JV, seqDepth)
			
			# 13) Re-get J and V sequences:
			## second round: to phase reads based on mutations
			## third round: to get final sequence based on all reads assigned to each rearrangement
			information = getJandVsequences("second", seq, phaseReadsBasedOnMutations, information, annot_table_JV, GENE, refGenome, snps_file, baseq, chromGene, bamN, pairedMode, miniBamT, miniBamN, depth, altDepth, tumorPurity, vafCutoff, vafCutoffNormal, pathToSamtools, threadsForSamtools, errLogMpileup)
			information = getJandVsequences("third", seq, phaseReadsBasedOnMutations, information, annot_table_JV, GENE, refGenome, snps_file, baseq, chromGene, bamN, pairedMode, miniBamT, miniBamN, depth, altDepth, tumorPurity, vafCutoff, vafCutoffNormal, pathToSamtools, threadsForSamtools, errLogMpileup)

			# 14) Collapse rearrangements with similar nucleotide sequences:
			if collapseSequences == "yes": information = doCollapseSequences(information, collapseSequencesSimilarity, GENE)

			# 15) Check homology and functionality (productive/unproductive):
			information = checkHomologyAndFunctionality(information, GENE) if annotateSeq == "builtin" else igBlastAnnotate(information, GENE, wkDir, inputsFolder, germline_db_J, germline_db_D, germline_db_V, seq, primer, primerStringency, primerFasta, agsAnnotation)

			# 16) Add mapping quality and calculate score:
			information = addMapQualAndScore(information, miniBamT, tumorPurity, pathToSamtools, threadsForSamtools)

			# 17) Adjust read names and update sequence of partial rearrangements:
			information = adjustReadNamesAndPartialRearrangements(information, GENE)
			
			# 18) Annotate CLL stereotyped subsets and IGLV3-21 R110:
			if GENE == "IGH" and subsetsAnnotation != "no": information = annotateCLLsubsets(information, subsetsAnnotation)
			if GENE == "IGL" and R110annotation == "yes": information = annotateR110mutation(information)
			
			# 19) Pre-defined filter:
			trip = predefinedFilter(information, seq, seqDepth, reportOnlyProductive, scoreCutoff, genomeVersion, collapseSequencesSimilarity)
			
			# 20) Save output and clean:
			Vseq = open(bamT.replace(".bam", "_output_"+GENE+".tsv"), "w")
			Vseq.write("Genes\tMechanism\tN_split\tN_insertSize\tStart_J\tEnd_J\tN_split_rescued_J\tStart_V\tEnd_V\tN_split_rescued_V\tN_phased_rescued\tSeq_J\tSeq_D\tSeq_V\tSeq_V_normal\tSeq\tV_gene_pct_identity_to_germline\tLength_considered_identity\tFunctionality\tJunction_amino_acid_sequence\tScore\tMQ\tV_gene_phase_info"+("" if reportReadNames == "no" else "\tRead_names")+"\n")
			if len(information) > 0:
				indxs = [21]+list(range(1,15))+list(range(16,20))+[20]+list(range(22,24))+[15]
